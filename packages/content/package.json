{
  "name": "@nms/content",
  "version": "0.1.0",
  "private": true,
  "description": "New Manager Success course content. Module 1 (locked script) structured for the feed player.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "report:ip": "node --experimental-strip-types scripts/ip-report.ts",
    "report:content": "node --experimental-strip-types scripts/content-report.ts",
    "shotlist": "node --experimental-strip-types scripts/shot-list.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
