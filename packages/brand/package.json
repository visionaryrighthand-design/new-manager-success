{
  "name": "@nms/brand",
  "version": "0.1.0",
  "private": true,
  "description": "New Manager Success design tokens, logo assets, and voice constants.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./assets/tokens.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/gen-tokens.mjs && node scripts/check-tokens.mjs",
    "test": "node --test --test-reporter=spec 'dist/**/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
