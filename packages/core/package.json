{
  "name": "@nms/core",
  "version": "0.1.0",
  "private": true,
  "description": "New Manager Success domain logic: registration, update levels, inactivity alerts, digests, progress, streaks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'dist-test/**/*.test.js'",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@nms/content": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
